<%- include("partials/head", { title: "MyAnimeSite" }) %>

    <main>

        <section class="search-results">

            <% for (let anime of data) { %>

                <a class="anime-card-link" href="/anime/<%= anime.node.id %>">

                    <article class="anime-card">

                        <% if (anime.node.main_picture) { %>

                            <div class="anime-card-poster">

                                <img class="anime-card-image" src="<%= anime.node.main_picture.large %>"
                                    alt="<%= anime.node.title %>">

                                <span class="anime-type">
                                    <%= anime.node.media_type %>
                                </span>

                            </div>

                            <% } %>


                                <div class="anime-card-content">

                                    <h2>
                                        <%= anime.node.title %>
                                    </h2>

                                </div>

                    </article>

                </a>

                <% } %>

        </section>

        <% if (nextUrl) { %>

            <div class="pagination">
                <a href="/next" class="pagination-button">
                    Load More
                </a>
            </div>

            <% } %>

    </main>

    <%- include("partials/footer") %>