# MyAnimeList API Credentials
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here

# Database Configuration (Option 1: Cloud Postgres like Neon, Supabase, Render, Railway)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Database Configuration (Option 2: Local Postgres fallback)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_local_password
PG_DATABASE=myanimesite

# Client URL for CORS (e.g., your Vercel deployment URL)
CLIENT_URL=https://your-anime-site.vercel.app
PORT=3000
